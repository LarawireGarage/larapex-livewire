<?php

namespace {{ namespace }};

use LarawireGarage\LarapexLivewire\LivewireChartComponent;
use LarawireGarage\LarapexLivewire\Wireable\{{ chart }};

class {{ class }} extends LivewireChartComponent
{
    protected $listeners = [];

    private function dataSource(){
        // Dataset logic
        return array_map(fn ($value) => [$value, rand(1, 100)], range(1, 20));
    }

    public function build()
    {
        $this->chart = (new {{ chart }}($this->chart_id)) // ->id($this->chart_id)
            ->addColumn('sample-1', $this->dataSource())
            ->addArea('sample-2', $this->dataSource())
            ->addLine('sample-3', $this->dataSource())
            ->set('stroke', 'width', [0, 2, 5])
            ->setTitle('Multi Axis Chart')
            ->set('title', 'align', 'center')
            ->showDataLabels(false)
            ->randomColors()
            // /**
            //  * using heredoc
            //  */
            // ->jsCallback('tooltip.y.formatter', <<<HTML
            //     function(value,{series,seriesIndex,dataPointIndex,w}){
            //         return value;
            //     }
            // HTML)
            // /**
            //  * using String
            //  */
            // ->jsCallback('dataLabels.formatter', "function (val, opts) {
            //     return val + '$'
            // }")
            ;
    }
}
